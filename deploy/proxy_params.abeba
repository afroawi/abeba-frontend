proxy_http_version 1.1;
proxy_set_header Host $abeba_backend_host;
# Reconstruct the browser origin explicitly; do not forward client-supplied values.
proxy_set_header X-Forwarded-Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
# Host Nginx overwrites client-supplied X-Forwarded-For; retain that client IP.
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $abeba_forwarded_proto;
proxy_connect_timeout 10s;
proxy_read_timeout 180s;
proxy_send_timeout 180s;

# Verify the deployed backend's HTTPS certificate and send its hostname as SNI.
proxy_ssl_server_name on;
proxy_ssl_verify on;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
proxy_ssl_verify_depth 3;
